---
import BaseLayout from '../layouts/BaseLayout.astro';

const files = import.meta.glob('../data/weekly/*.json', { eager: true });

interface EvidenceItem {
  type: string;
  content: string;
  source: string;
}
interface WeeklyEvent {
  id: string;
  title: string;
  impactScore: number;
  infoGainScore: number;
  summary: string;
  classAnalysis?: { classNature: string; contradiction: string; historicalContext: string };
  dialecticalSummary?: string;
  evidence?: EvidenceItem[];
}
interface WeeklyData {
  id: string;
  weekStart: string;
  weekEnd: string;
  events: WeeklyEvent[];
}

const weeks: { id: string; data: WeeklyData }[] = [];
for (const [path, mod] of Object.entries(files)) {
  const id = path.split('/').pop()?.replace('.json', '') || '';
  const data = ((mod as any).default || mod) as WeeklyData;
  weeks.push({ id, data });
}
weeks.sort((a, b) => b.id.localeCompare(a.id));

const totalEvents = weeks.reduce((n, w) => n + (w.data.events?.length ?? 0), 0);
const blogPostUrl = (id: string) => `https://blog.dreamnight.net.cn/posts/${id.toLowerCase()}/`;
---

<BaseLayout title="格物 Dianalyze — 每周热点辩证分析">
  <section class="hero" aria-labelledby="hero-title">
    <p class="kicker">DIANALYZE · 格物</p>
    <h1 id="hero-title">每周热点 · 辩证分析</h1>
    <p class="stats">
      共 <strong>{weeks.length}</strong> 期 · <strong>{totalEvents}</strong> 个事件 · 每周一自动生成；
      每期文章同步发表于博客。
    </p>
  </section>

  {weeks.map((w) => (
    <section class="week" id={w.id.toLowerCase()} aria-label={w.id}>
      <header class="week-head">
        <h2 class="week-id">{w.id}</h2>
        <span class="range">{w.data.weekStart} ~ {w.data.weekEnd}</span>
        <a class="post-link dn-focus" href={blogPostUrl(w.id)} target="_blank" rel="noopener">阅读文章 ↗</a>
      </header>
      {w.data.events && w.data.events.length > 0 ? (
        <div class="events">
          {w.data.events.map((e) => (
            <details class="ev">
              <summary>
                <span class="scores">
                  <span class="chip chip-impact">影响 {e.impactScore}</span>
                  <span class="chip chip-gain">增量 {e.infoGainScore}</span>
                </span>
                <span class="ev-title">{e.title}</span>
                <span class="chev" aria-hidden="true">▾</span>
              </summary>
              <div class="ev-body">
                <p class="summary">{e.summary}</p>
                {e.dialecticalSummary && (
                  <div class="block">
                    <h4>辩证总结</h4>
                    <p>{e.dialecticalSummary}</p>
                  </div>
                )}
                {e.classAnalysis && (
                  <div class="block">
                    <h4>阶级分析</h4>
                    <p><strong>阶级本质：</strong>{e.classAnalysis.classNature}</p>
                    <p><strong>主要矛盾：</strong>{e.classAnalysis.contradiction}</p>
                    <p><strong>历史脉络：</strong>{e.classAnalysis.historicalContext}</p>
                  </div>
                )}
                {e.evidence && e.evidence.length > 0 && (
                  <div class="block">
                    <h4>证据链</h4>
                    <ul class="evidence">
                      {e.evidence.map((ev) => (
                        <li>
                          <span class="ev-type">{ev.type}</span>
                          <span>{ev.content}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>
            </details>
          ))}
        </div>
      ) : (
        <p class="empty">本期暂无事件数据。</p>
      )}
    </section>
  ))}

  {weeks.length === 0 && <p class="empty">暂无周报数据。</p>}
</BaseLayout>

<style>
  .hero {
    padding: clamp(2rem, 7vw, 4.5rem) 0 clamp(1.5rem, 4vw, 2.5rem);
  }
  .stats {
    margin: 1.25rem 0 0;
    color: var(--dn-text-secondary);
  }
  .stats strong {
    color: var(--dn-text-primary);
    font-weight: 600;
  }
  .week {
    margin-bottom: 3rem;
  }
  .week-head {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
    padding: 0.5rem 0;
    border-bottom: 2px solid var(--dn-text-primary);
  }
  .week-id {
    font-size: var(--dn-size-h2);
  }
  .range {
    color: var(--dn-text-secondary);
    font-size: 0.9rem;
  }
  .post-link {
    margin-left: auto;
    color: var(--dn-text-secondary);
    font-size: 0.9rem;
    text-decoration: none;
  }
  .post-link:hover {
    color: var(--dn-text-primary);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .ev {
    border-bottom: 1px solid var(--dn-divider);
  }
  .ev summary {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.9rem 0.5rem;
    cursor: pointer;
    list-style: none;
  }
  .ev summary::-webkit-details-marker {
    display: none;
  }
  .ev summary:hover {
    background: var(--dn-surface);
  }
  .scores {
    display: flex;
    gap: 0.35rem;
    flex-shrink: 0;
    padding-top: 0.1rem;
  }
  .chip {
    display: inline-block;
    padding: 0 0.45rem;
    font-size: 0.75rem;
    line-height: 1.6;
    font-weight: 600;
    color: var(--dn-text-on-color);
  }
  .chip-impact {
    background: var(--dn-violet);
  }
  .chip-gain {
    background: var(--dn-cyan);
  }
  .ev-title {
    flex: 1;
    font-weight: 600;
  }
  .chev {
    flex-shrink: 0;
    color: var(--dn-text-secondary);
    transition: transform var(--dn-duration-hover) var(--dn-ease-in);
  }
  .ev[open] .chev {
    transform: rotate(180deg);
  }
  .ev-body {
    padding: 0 0.5rem 1.25rem 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .summary {
    margin: 0;
    color: var(--dn-text-secondary);
  }
  .block h4 {
    margin: 0 0 0.35rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--dn-text-primary);
  }
  .block p {
    margin: 0 0 0.5rem;
    color: var(--dn-text-secondary);
    font-size: 0.95rem;
  }
  .block p:last-child {
    margin-bottom: 0;
  }
  .block strong {
    color: var(--dn-text-primary);
    font-weight: 600;
  }
  .evidence {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .evidence li {
    display: flex;
    gap: 0.5rem;
    font-size: 0.95rem;
    color: var(--dn-text-secondary);
  }
  .ev-type {
    flex-shrink: 0;
    padding: 0 0.4rem;
    border: 1px solid var(--dn-divider);
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--dn-text-secondary);
  }
  .empty {
    color: var(--dn-text-secondary);
    padding: 2rem 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .chev {
      transition: none;
    }
  }
</style>