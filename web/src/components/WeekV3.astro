          <dd>{duration ?? '未记录'}</dd>
        </div>
        <div>
          <dt>API 费用</dt>
          <dd>{cost ?? '未记录'}</dd>
        </div>
        <div>
          <dt>核验轮次</dt>
          <dd>{week.meta.verificationPasses ?? '未记录'}</dd>
        </div>
        <div>
          <dt>降级阶段</dt>
          <dd>
            {week.meta.empiricalDegradations.length > 0
              ? week.meta.empiricalDegradations.join('、')
              : '无'}
          </dd>
        </div>
        <div>
          <dt>运行编号</dt>
          <dd>{week.meta.runId ?? '未记录'}</dd>
        </div>
      </dl>
    </div>
  </section>
)}

