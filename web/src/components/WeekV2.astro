---
import type { Week } from '../lib/weeks';
import RelatedRefs from './RelatedRefs.astro';
import { eventTitles } from '../lib/weeks';

interface Props {
  week: Week;
}

const { week } = Astro.props;
const titles = eventTitles(week);
const synthesis = week.synthesis;

const directionTone = (direction?: string) => {
  if (!direction) return 'chip-steel';
  if (direction.includes('上升')) return 'chip-emerald';
  if (direction.includes('激化')) return 'chip-crimson';
  if (direction.includes('下降') || direction.includes('缓和')) return 'chip-teal';
  return 'chip-amber';
};

const stateTone = (state?: string) => {
  if (!state) return 'chip-steel';
  if (state.includes('公开') || state.includes('激')) return 'chip-crimson';
  if (state.includes('隐性') || state.includes('积累')) return 'chip-amber';
  return 'chip-steel';
};
---

<section class="phase" id="synthesis" aria-labelledby="synthesis-title">
  <header class="phase-head field field-teal">
    <div class="shell">
      <p class="kicker">CROSS-EVENT SYNTHESIS</p>
      <h2 id="synthesis-title">跨事件综合</h2>
      <p class="phase-note">
        本期数据属于 v2 结构：不包含 phase1–5 与断言核验档案，
        综合结论以主题、趋势与正在运动的矛盾三种形式给出。
      </p>
    </div>
  </header>

  <div class="shell phase-body">
    {synthesis ? (
      <>
        {synthesis.crossCuttingThemes.length > 0 && (
          <section class="sub-section" aria-labelledby="themes-title">
            <h3 class="sub-title" id="themes-title">跨事件主题</h3>
            <div class="cards">
              {synthesis.crossCuttingThemes.map((theme) => (
                <article class="theme-card">
                  <h4>{theme.name}</h4>
                  {theme.description && <p>{theme.description}</p>}
                  {theme.significance && (
                    <p class="theme-significance">意义：{theme.significance}</p>
                  )}
                  <RelatedRefs ids={theme.relatedEventIds} titles={titles} />
                </article>
              ))}
            </div>
          </section>
        )}

        {synthesis.trends.length > 0 && (
          <section class="sub-section" aria-labelledby="trends-title">
            <h3 class="sub-title" id="trends-title">趋势</h3>
            <ul class="rows">
              {synthesis.trends.map((trend) => (
                <li>
                  <p class="row-head">
                    <span class="row-name">{trend.name}</span>
                    {trend.direction && (
                      <span class={`chip ${directionTone(trend.direction)}`}>
                        走向 {trend.direction}
                      </span>
                    )}
                  </p>
                  {trend.description && <p>{trend.description}</p>}
                  <RelatedRefs ids={trend.evidenceEventIds} titles={titles} label="依据事件" />
                </li>
              ))}
            </ul>
          </section>
        )}

        {synthesis.contradictionsInMotion.length > 0 && (
          <section class="sub-section" aria-labelledby="motion-title">
            <h3 class="sub-title" id="motion-title">正在运动的矛盾</h3>
            <ul class="rows">
              {synthesis.contradictionsInMotion.map((item) => (
                <li>
                  <p class="row-head">
                    <span class="row-name">{item.contradiction}</span>
                    {item.currentState && (
                      <span class={`chip ${stateTone(item.currentState)}`}>
                        当前状态 {item.currentState}
                      </span>
                    )}
                  </p>
                  {item.opposingForces && (
                    <p><strong>对立双方　</strong>{item.opposingForces}</p>
                  )}
                  {item.outlook && <p class="row-note">可能走向：{item.outlook}</p>}
                  <RelatedRefs ids={item.eventsInvolved} titles={titles} label="涉及事件" />
                </li>
              ))}
            </ul>
          </section>
        )}

        {synthesis.dataGaps.length > 0 && (
          <section class="sub-section" aria-labelledby="gaps-title">
            <h3 class="sub-title" id="gaps-title">数据缺口</h3>
            <ul class="gaps">
              {synthesis.dataGaps.map((gap) => (
                <li>{gap}</li>
              ))}
            </ul>
          </section>
        )}
      </>
    ) : (
      <p class="phase-empty">
        本期数据中没有跨事件综合字段（synthesis），因此没有主题、趋势与矛盾运动的记录。
        本节保留为空态，不用推测内容填充。
      </p>
    )}
  </div>
</section>

<style>
  .phase-empty {
    font-size: 0.9375rem;
    line-height: 1.8;
    color: var(--dn-text-secondary);
    max-width: 76ch;
  }
  .phase-head {
    padding: 1.5rem 0 1.75rem;
  }
  .phase-head h2 {
    margin-top: 0.25rem;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
  }
  .phase-note {
    margin-top: 0.5rem;
    font-size: 0.9375rem;
    line-height: 1.7;
    max-width: 68ch;
  }
  .phase-body {
    display: grid;
    gap: 2rem;
    padding: clamp(1.75rem, 4vw, 2.75rem) var(--site-gutter);
  }
  .sub-section {
    display: grid;
    gap: 1rem;
  }
  .sub-title {
    font-size: 1.375rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--dn-divider);
  }
  .cards {
    display: grid;
    gap: 1rem;
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 760px) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .theme-card {
    display: grid;
    gap: 0.5rem;
    align-content: start;
    padding: 1.25rem;
    background: var(--dn-surface);
    border-top: 4px solid var(--dn-teal);
  }
  .theme-card h4 {
    font-family: var(--dn-font-display);
    font-size: 1.25rem;
    font-weight: var(--dn-weight-display);
  }
  .theme-card p {
    font-size: 0.9375rem;
    line-height: 1.75;
    max-width: 72ch;
  }
  .theme-significance {
    font-size: 0.875rem !important;
    color: var(--dn-text-secondary);
  }
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--dn-divider);
  }
  .rows li {
    display: grid;
    gap: 0.5rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--dn-divider);
  }
  .rows p {
    font-size: 0.9375rem;
    line-height: 1.8;
    max-width: 78ch;
  }
  .row-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
  }
  .row-name {
    font-family: var(--dn-font-display);
    font-size: 1.25rem;
    font-weight: var(--dn-weight-display);
  }
  .row-note {
    font-size: 0.875rem !important;
    color: var(--dn-text-secondary);
  }
  .gaps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  .gaps li {
    padding-left: 1rem;
    border-left: 3px solid var(--dn-amber);
    font-size: 0.9375rem;
    line-height: 1.75;
    max-width: 78ch;
  }
</style>